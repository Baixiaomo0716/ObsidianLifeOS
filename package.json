{
  "name": "life-os",
  "version": "0.1.0",
  "private": true,
  "description": "LifeOS Obsidian plugin: engineering foundation",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "dev:vault": "node esbuild.config.mjs --watch --vault",
    "package:preview": "pnpm check && pwsh -NoProfile -File scripts/package-preview.ps1",
    "install:vault": "pnpm build && node esbuild.config.mjs --vault",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && node esbuild.config.mjs",
    "verify": "node scripts/verify-build.mjs",
    "test:lifecycle": "node --test scripts/lifecycle.test.mjs",
    "test:domain": "node --test scripts/domain.test.mjs",
    "test:storage": "node --test scripts/storage.test.mjs scripts/obsidian-file-system.test.mjs scripts/storage-roundtrip.test.mjs scripts/identity-scan.test.mjs",
    "test:operations": "node --test scripts/operations.test.mjs",
    "test:recovery": "node --test scripts/restore-verification.test.mjs scripts/merge-conflict.test.mjs",
    "benchmark": "node scripts/benchmark.mjs --disk",
    "test:sync-local": "node scripts/git-sync-verification.mjs",
    "test:workflows": "node --test scripts/workflows.test.mjs",
    "test:period-review": "node --test scripts/period-review.test.mjs scripts/period-review-page.test.mjs",
    "test:tags": "node --test scripts/tags.test.mjs scripts/tag-page.test.mjs",
    "test:knowledge": "node --test scripts/knowledge.test.mjs scripts/knowledge-page.test.mjs",
    "test:p2": "node --test scripts/p2-integration.test.mjs",
    "test:travel": "node --test scripts/travel.test.mjs scripts/travel-page.test.mjs",
    "test:performance": "node --test scripts/performance.test.mjs scripts/performance-page.test.mjs",
    "test:game": "node --test scripts/game.test.mjs scripts/game-page.test.mjs",
    "test:film": "node --test scripts/film.test.mjs scripts/film-page.test.mjs",
    "test:reading": "node --test scripts/reading.test.mjs scripts/reading-page.test.mjs",
    "test:projects": "node --test scripts/project-service.test.mjs scripts/project-page.test.mjs scripts/project-lifecycle.test.mjs scripts/project-flow-modal.test.mjs scripts/project-board.test.mjs scripts/project-board-page.test.mjs",
    "test:ledger": "node --test scripts/ledger-service.test.mjs scripts/ledger-form.test.mjs scripts/ledger-rules.test.mjs scripts/ledger-table.test.mjs scripts/ledger-page.test.mjs",
    "test:tasks": "node --test scripts/task-service.test.mjs scripts/task-modal.test.mjs scripts/task-list.test.mjs scripts/task-page.test.mjs",
    "test:journal": "node --test scripts/journal.test.mjs scripts/journal-ui.test.mjs scripts/journal-relations.test.mjs",
    "test:attachments": "node --test scripts/attachments.test.mjs scripts/binary-file-system.test.mjs scripts/attachment-import-modal.test.mjs scripts/project-files.test.mjs",
    "test:relations": "node --test scripts/relation-service.test.mjs scripts/relation-picker.test.mjs",
    "test:index": "node --test scripts/entity-index.test.mjs scripts/search-service.test.mjs scripts/summary.test.mjs",
    "test:settings": "node --test scripts/settings.test.mjs",
    "preview:ui": "node scripts/preview-ui.mjs",
    "test:ui": "node --test scripts/ui.test.mjs scripts/layout-check.test.mjs",
    "test:templates": "node --test scripts/templates.test.mjs",
    "test:chinese-fields": "node --test scripts/chinese-fields.test.mjs",
    "test:unified-templates": "node --test scripts/unified-templates.test.mjs",
    "migrate:chinese": "node scripts/migrate-chinese-fields.mjs --vault",
    "check": "pnpm build && pnpm verify && pnpm test:lifecycle && pnpm test:domain && pnpm test:storage && pnpm test:operations && pnpm test:index && pnpm test:relations && pnpm test:attachments && pnpm test:journal && pnpm test:tasks && pnpm test:ledger && pnpm test:projects && pnpm test:reading && pnpm test:film && pnpm test:game && pnpm test:performance && pnpm test:travel && pnpm test:p2 && pnpm test:knowledge && pnpm test:tags && pnpm test:period-review && pnpm test:workflows && pnpm test:recovery && pnpm test:settings && pnpm test:ui && pnpm test:templates && pnpm test:chinese-fields && pnpm test:unified-templates"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "obsidian": "1.13.1",
    "typescript": "7.0.2"
  }
}




